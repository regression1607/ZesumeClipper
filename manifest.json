{
  "manifest_version": 3,
  "name": "Zesume Clipper",
  "version": "0.1.0",
  "description": "Clip any job description and tailor your Zesume.ai resume to it in one click.",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Zesume Clipper — toggle side panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content-scripts/jd-scraper.js",
        "content-scripts/apply-scraper.js",
        "content-scripts/apply-filler.js",
        "content-scripts/apply-submitter.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "popup/popup.html"
  }
}
